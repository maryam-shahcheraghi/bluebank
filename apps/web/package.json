{
  "name": "@bluebank/web",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/apps/web/server.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit --incremental false"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "typescript": "6.0.3"
  }
}
