# Optional apps/api/.env; existing process variables take precedence.
# Defaults without a file: development, port 4000, loopback, CORS disabled.
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
# Use HOST=0.0.0.0 in a container to accept traffic through published ports.
# Optional exact frontend origins; omit to disable CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
